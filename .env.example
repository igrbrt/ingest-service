NODE_ENV=development
PORT=3000
DATABASE_URL=mongodb://localhost:27017/ingest?replicaSet=rs0&directConnection=true
REDIS_HOST=localhost
REDIS_PORT=6379
INGEST_API_KEY=local-ingest-key
ADMIN_API_KEY=local-admin-key
PROCESSING_DELAY_MS=5000
REORDER_WINDOW_MS=15000
WORKER_CONCURRENCY=100
MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
LEASE_MS=60000
RECONCILER_INTERVAL_MS=5000
